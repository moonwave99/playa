{
  "name": "playa",
  "productName": "Playa",
  "version": "0.5.0",
  "repository": "https://github.com/moonwave99/playa",
  "homepage": "https://moonwave99.github.io/playa",
  "author": {
    "name": "Diego Caponera",
    "email": "hello@diegocaponera.com",
    "url": "https://www.diegocaponera.com"
  },
  "main": ".vite/build/main.js",
  "scripts": {
    "postinstall": "npm run db:generate",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "db:seed": "cp /Applications/Playa.app/Contents/Resources/data.db ./dump/data-$(date +'%Y-%m-%d_%H-%M-%S').db && rm -f data.db && npm run db:migrate && npx tsx ./src/main/db/seed.ts",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev --name init",
    "db:studio": "npx prisma studio",
    "db:dump": "pg_dump music > \"./dump/music-$(date +'%Y-%m-%d_%H-%M-%S').sql\"",
    "test:renderer": "npx vitest --config vite.renderer.config.ts",
    "test:main": "npx vitest --config vite.main.config.ts",
    "coverage:renderer": "npx vitest run --coverage --config vite.renderer.config.ts",
    "coverage:main": "npx vitest run --coverage --config vite.main.config.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.7.0",
    "@electron-forge/maker-deb": "^7.7.0",
    "@electron-forge/maker-rpm": "^7.7.0",
    "@electron-forge/maker-squirrel": "^7.7.0",
    "@electron-forge/maker-zip": "^7.7.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.7.0",
    "@electron-forge/plugin-fuses": "^7.7.0",
    "@electron-forge/plugin-vite": "^7.7.0",
    "@electron/fuses": "^1.8.0",
    "@react-router/dev": "^7.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/lodash": "^4.17.16",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/react-modal": "^3.16.3",
    "@types/sha1": "^1.1.5",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-istanbul": "^3.1.1",
    "electron": "35.0.1",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.2.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "vite": "^6.2.5",
    "vitest": "^3.1.1",
    "vitest-mock-extended": "^3.0.1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@observablehq/plot": "^0.6.17",
    "@prisma/client": "^6.5.0",
    "@react-router/node": "^7.3.0",
    "@react-router/serve": "^7.3.0",
    "@tanstack/react-query": "^5.68.0",
    "@tanstack/react-virtual": "^3.13.4",
    "@testing-library/user-event": "^14.6.1",
    "clsx": "^2.1.1",
    "electron-settings": "^4.0.4",
    "electron-squirrel-startup": "^1.0.1",
    "globby": "^14.1.0",
    "image-downloader": "^4.3.0",
    "lodash": "^4.17.21",
    "music-metadata": "^11.0.2",
    "picocolors": "^1.1.1",
    "prisma": "^6.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "react-modal": "^3.16.3",
    "react-responsive": "^10.0.1",
    "react-router": "^7.3.0",
    "run-applescript": "^7.0.0",
    "sha1": "^1.1.1",
    "use-debounce": "^10.0.4",
    "vite-plugin-svgr": "^4.3.0",
    "zustand": "^5.0.3"
  }
}
