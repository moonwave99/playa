    "@vitest/coverage-istanbul": "^3.1.1",
    "electron": "35.0.1",
    "electron-playwright-helpers": "^1.8.2",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.2.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jimp": "^1.6.0",
    "jsdom": "^26.0.0",
