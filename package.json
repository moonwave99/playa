{
  "name": "playa",
  "description": "The music manager that thinks in albums",
  "productName": "Playa",
  "version": "0.5.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonwave99/playa.git"
  },
  "homepage": "https://moonwave99.github.io/playa",
  "author": {
    "name": "Diego Caponera",
    "email": "hello@diegocaponera.com",
    "url": "https://www.diegocaponera.com"
  },
  "main": ".vite/build/main.js",
  "scripts": {
    "postinstall": "pnpm run db:generate",
    "start": "pnpm electron-forge start",
    "package": "pnpm run db:reset && electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "clean": "rm -rf out",
    "db:reset": "rm -f ./src/main/db/data.db && pnpm prisma db push",
    "db:seed": "rm -f ./src/main/db/data.db && pnpm run db:migrate && pnpm tsx ./src/main/db/seed.ts",
    "db:generate": "pnpm prisma generate",
    "db:migrate": "pnpm prisma migrate dev --name init",
    "db:studio": "pnpm prisma studio",
    "db:backup": "cp /Applications/Playa.app/Contents/Resources/data.db ./dump/data-$(date +'%Y-%m-%d_%H-%M-%S').db",
    "test:renderer": "vitest --config vite.renderer.config.ts",
    "test:main": "vitest --config vite.main.config.ts",
    "test:e2e": "playwright test",
    "coverage:renderer": "vitest run --coverage --config vite.renderer.config.ts",
    "coverage:main": "vitest run --coverage --config vite.main.config.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.7.0",
    "@electron-forge/maker-deb": "^7.7.0",
    "@electron-forge/maker-dmg": "^7.9.0",
    "@electron-forge/maker-rpm": "^7.7.0",
    "@electron-forge/maker-squirrel": "^7.7.0",
    "@electron-forge/maker-zip": "^7.7.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.7.0",
    "@electron-forge/plugin-fuses": "^7.7.0",
    "@electron-forge/plugin-vite": "^7.7.0",
    "@electron/fuses": "^1.8.0",
    "@moonwave99/prismock": "^1.0.0",
    "@moonwave99/test-fs": "^0.0.5",
    "@playwright/test": "^1.55.1",
    "@react-router/dev": "^7.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/lodash": "^4.17.16",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
