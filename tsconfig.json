{
    "compilerOptions": {
        "target": "ESNext",
        "module": "commonjs",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "allowJs": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "noImplicitAny": true,
        "sourceMap": true,
        "outDir": "dist",
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "jsx": "react-jsx",
        "lib": ["ES2023", "DOM", "DOM.Iterable", "ESNext.Array"],
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src"],
    "files": ["src/types/types.d.ts"]
}
