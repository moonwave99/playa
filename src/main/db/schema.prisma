generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client-generated"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres:postgres@localhost:5432/music"
}

model Artist {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  name      String    @db.VarChar(255)
  hash      String    @unique @db.VarChar(16)
  path      String    @default("") @db.VarChar(255)
  releases  Release[]
  notes     Note[]    @relation("ArtistToNote")

  @@index([hash], type: Hash)
}

model Release {
  id            Int          @id @default(autoincrement())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  title         String       @db.VarChar(255)
  hash          String       @unique @db.VarChar(16)
  path          String       @db.VarChar(255)
  type          ReleaseType  @default(Album)
  year          Int?
  disc          Int?         @default(1)
  total_discs   Int?         @default(1)
  artist_id     Int
  artist        Artist       @relation(fields: [artist_id], references: [id])
  tracks        Track[]
  notes         Note[]       @relation("NoteToRelease")
  collections   Collection[] @relation("CollectionToRelease")
  mainReleaseId Int?
  mainRelease   Release?     @relation("ReleaseGroup", fields: [mainReleaseId], references: [id])
  subReleases   Release[]    @relation("ReleaseGroup")

  @@index([hash], type: Hash)
}

model Track {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String   @db.VarChar(255)
  hash      String   @unique @db.VarChar(16)
  path      String   @db.VarChar(255)
  duration  Int
  releaseId Int
  position  Int
  Release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([hash], type: Hash)
}

model Collection {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  title     String    @db.VarChar(255)
  releases  Release[] @relation("CollectionToRelease")
}

model Note {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  title     String    @db.VarChar(255)
  content   String
  artists   Artist[]  @relation("ArtistToNote")
  releases  Release[] @relation("NoteToRelease")
}

enum ReleaseType {
  Album
  EP
  Single
  Compilation
  Bootleg
  Various
  Tribute
  Soundtrack
}
