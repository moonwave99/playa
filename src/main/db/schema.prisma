generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client-generated"
}

datasource db {
  provider = "sqlite"
  url      = "file:data.db"
}

model Artist {
  id                      Int        @id @default(autoincrement())
  entityType              EntityType @default(Artist)
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  name                    String
  normalizedName          String     @default("")
  hash                    String     @unique
  path                    String     @default("")
  coverReleaseId          Int?       @unique
  coverRelease            Release?   @relation("ArtistCover", fields: [coverReleaseId], references: [id])
  coverGroups             Group[]    @relation("GroupCover")
  releases                Release[]
  appearsIn               Release[]  @relation("AppearsInRelease")
  groups                  Group[]    @relation("GroupToArtist")
  relatedArtists          Artist[]   @relation("RelatedArtists")
  symmetricRelatedArtists Artist[]   @relation("RelatedArtists")

  @@index([hash])
}

model Release {
  id                Int          @id @default(autoincrement())
  entityType        EntityType   @default(Release)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  title             String
  normalizedTitle   String       @default("")
  hash              String       @unique
  path              String       @default("")
  completePath      String       @default("")
  colorInfo         Json?
  type              ReleaseType  @default(Album)
  year              Int?
  discTitle         String?
  discNumber        Int?         @default(1)
  hideOnHomepage    Boolean?     @default(false)
  artist_id         Int
  mainReleaseId     Int?
  coverArtist       Artist?      @relation("ArtistCover")
  coverCollections  Collection[] @relation("CollectionCover")
  mainRelease       Release?     @relation("ReleaseGroup", fields: [mainReleaseId], references: [id], onDelete: Cascade)
  subReleases       Release[]    @relation("ReleaseGroup")
  artist            Artist       @relation(fields: [artist_id], references: [id], onDelete: Cascade)
  tracks            Track[]
  additionalArtists Artist[]     @relation("AppearsInRelease")
  collections       Collection[] @relation("CollectionToRelease")

  @@index([hash])
}

model Track {
  id                    Int        @id @default(autoincrement())
  entityType            EntityType @default(Track)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  title                 String
  normalizedTitle       String     @default("")
  hash                  String     @unique
  path                  String
  duration              Int
  releaseId             Int
  position              Int
  trackArtist           String?    @default("")
  normalizedTrackArtist String?    @default("")
  release               Release    @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([hash])
}

model Collection {
  id             Int        @id @default(autoincrement())
  entityType     EntityType @default(Collection)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  title          String
  coverReleaseId Int?
  coverRelease   Release?   @relation("CollectionCover", fields: [coverReleaseId], references: [id])
  releases       Release[]  @relation("CollectionToRelease")
}

model Group {
  id            Int        @id @default(autoincrement())
  entityType    EntityType @default(Group)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  title         String
  description   String?
  coverArtistId Int?
  coverArtist   Artist?    @relation("GroupCover", fields: [coverArtistId], references: [id])
  artists       Artist[]   @relation("GroupToArtist")
}

model Settings {
  id                         Int     @id @default(autoincrement())
  SHOW_ONBOARDING_ON_STARTUP Boolean @default(true)
  USE_SMART_IMPORT           Boolean @default(false)
  PLAYER_PATH                String  @default("")
  TAGGER_PATH                String  @default("")
  LIBRARY_PATH               String  @default("")
  COVERS_PATH                String  @default("")
  DISCOGS_KEY                String  @default("")
  DISCOGS_SECRET             String  @default("")
}

enum ReleaseType {
  Album
  EP
  Single
  Compilation
  Bootleg
  Various
  Tribute
  Soundtrack
}

enum EntityType {
  Artist
  Release
  Track
  Group
  Collection
}
