<section class="blog w-80-ns center ph3 ph0-ns pv6-ns">  
  <header class="mb5">
    <h1 class="f2 f1-ns lh-solid mt5 mt4-ns black">{{ labels.blog.title }}</h1>
    <p class="lh-copy black">{{ labels.blog.description }}</p>
  </header>
  <div class="flex flex-wrap">
    {{#each posts }}
    <article class="blog-post-content w-100 w-50-l pr4-l mb5">
      <header>
        <time class="tracked ttu">{{ formatDate date }}</time>
        <h2 class="f5 f4-ns lh-copy">
          <a class="link blue underline-hover" href="{{ getUrl slug }}">{{ title }}</a>
        </h2>
      </header>
      <p class="measure lh-copy">{{{ formatExcerpt excerpt }}}</p>
    </article>
    {{/each}}
  </div>
</section>