<article class="blog-post mw8-ns center ph3 pb5 pv4 pv6-ns">
  <header class="blog-post-header mb5">
    <time class="tracked ttu">{{ formatDate date }}</time>
    <h1 class="f3 f1-ns lh-solid mt4 mb4">{{ title }}</h1>
    {{#if isOld }}
    <p class="lh-copy i">
      <strong>Note:</strong> this post refers to a <a class="link blue underline-hover"
        href="https://github.com/moonwave99/playa/releases/tag/v0.4.2">previous version of Playa</a>.
    </p>
    {{/if}}
  </header>
  <section class="blog-post-content">
    {{{ content }}}
  </section>
</article>
<div class="album-bar relative overflow-hidden w-100 bg-mid-gray"></div>