<meta name="keywords" value="{{labels.meta.keywords}}"/>
{{#if excerpt}}
<meta name="description" content="{{excerpt}}" />
{{else}}
<meta name="description" content="{{description}}" />
{{/if}}
<meta property="og:site_name" content="{{labels.meta.title}} - {{labels.meta.description}}" />
<meta property="og:url" content="{{getUrl slug}}" />
<meta property="og:title" content="{{title}}" />
{{#if cover}}
<meta property="og:image" content="{{getCoverURL cover.url}}" />
{{/if}}
{{#if excerpt}}
<meta property="og:type" content="article" />
<meta name="og:description" content="{{excerpt}}" />
{{else}}
<meta name="og:description" content="{{description}}" />
{{/if}}
{{#if date}}
<meta property="article:published_time" content="{{getTimestamp date}}" />
{{/if}}